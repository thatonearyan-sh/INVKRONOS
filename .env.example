# ==============================================================
# INVKRONOS — PRIVACY ARCHITECTURE & LICENSING ENGINE
# ENVIRONMENT CONFIGURATION BLUEPRINT
# ==============================================================

# 1. MongoDB Atlas Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=kronos_licensing

# 2. Telegram Admin Bot Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_ADMIN_ID=your_telegram_user_id

# 3. Secret HMAC Key for Admin Quick-Approve Verification
SECRET_APPROVAL_KEY=generate_a_random_32_character_hex_secret

# 4. UPI Receiving Configuration (India Real-time Payments)
UPI_ID=your_business_vpa@upi
PAYEE_NAME=KRONOS

# 5. TON Blockchain Receiving Wallet
TON_WALLET=your_ton_wallet_address_here

# 6. Server Base API URL (Optional, default is dynamic from request)
# KRONOS_API_URL=https://your-deployment.vercel.app
